# Canonical site: https://drsenol.shop

NEXT_PUBLIC_SITE_URL=https://drsenol.shop
NEXT_PUBLIC_CDN_URL=https://cdn.drsenol.shop
NEXT_PUBLIC_SUPABASE_URL=https://afjjdslllhmoalyufabj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_SERVICE_ROLE_KEY=

# DATABASE_URL=

# Supabase CLI (supabase login / link) — Dashboard → Account → Access Tokens
# SUPABASE_ACCESS_TOKEN=

# ─── Resend (sipariş e-postaları) ─────────────────────────────
# Sipariş onayı, durum güncellemesi, ödeme hatırlatması (cron)
RESEND_API_KEY=
RESEND_FROM_EMAIL=siparis@drsenol.shop
RESEND_FROM_NAME=Dr. Şenol Shop
RESEND_REPLY_TO=bilgi@drsenol.shop

# ─── Telegram bot (yeni sipariş + admin komutları) ───────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Opsiyonel: ek admin chat ID'leri (virgülle)
# TELEGRAM_ADMIN_IDS=
# Webhook: POST https://drsenol.shop/api/telegram/webhook
# setWebhook secret_token ile aynı değer
# TELEGRAM_WEBHOOK_SECRET=

# ─── Vercel Cron (vercel.json) ────────────────────────────────
# /api/cron/order-reminders (08:00 UTC), /api/cron/low-stock (07:00 UTC)
CRON_SECRET=

# ─── PayTR (opsiyonel — env doluysa checkout'ta kart seçeneği) ─
# PAYTR_MERCHANT_ID=
# PAYTR_MERCHANT_KEY=
# PAYTR_MERCHANT_SALT=
# PAYTR_TEST_MODE=1

